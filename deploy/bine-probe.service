[Unit]
Description=BINE Scheduled Market Probe
After=network.target

[Service]
Type=oneshot
User=sheriff
Group=sheriff
WorkingDirectory=/home/sheriff/apps/bine/backend
EnvironmentFile=-/etc/bine/bine.env
ExecStart=/home/sheriff/apps/bine/.venv/bin/python -m bine.cli probe --scheduled
TimeoutSec=300

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sheriff/apps/bine /tmp
PrivateTmp=true

