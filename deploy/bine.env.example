# BINE Production Environment Template
# Copy to /etc/bine/bine.env with mode 0600 (chmod 600 /etc/bine/bine.env)
# Owned by deploy:deploy (chown deploy:deploy /etc/bine/bine.env)
#
# HARD SECURITY RULE:
# Never commit the populated file or share its contents.

# Binance Web3 Wallet API Credentials (read-only keys recommended)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Public Demo Lock
# Keep BINE_PUBLIC_DEMO=true for all public-facing instances.
# When true, live trading is permanently locked off and /api/execute is dry-run only.
BINE_PUBLIC_DEMO=true
BINE_LIVE_MODE=false

# Safety caps (USD)
BINE_MAX_TRADE_USD=6.00
BINE_DAILY_CAP_USD=10.00

# Administrative token (optional: required for privileged endpoints if enabled)
BINE_ADMIN_TOKEN=

# SQLite decision log storage path
BINE_DB_PATH=/var/lib/bine/bine.db

# Trusted reverse proxies for rate limiting (Caddy on localhost)
TRUSTED_PROXIES=127.0.0.1,::1

# Local DNS fallback (leave false unless outbound DNS to web3.binance.com times out)
DEV_DNS_FALLBACK=false
