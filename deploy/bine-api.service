[Unit]
Description=BINE Pre-Trade Guard API Service
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/bine/backend
EnvironmentFile=-/etc/bine/bine.env
ExecStart=/srv/bine/backend/.venv/bin/uvicorn bine.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bine /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
