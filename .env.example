# Binance Web3 API credentials (from https://web3.binance.com/en/dev-portal/project)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Local Bine backend URL used by CLI (`bine`) and MCP server (`bine-mcp`)
BINE_API_URL=http://localhost:8000

# Agent execution (default off, tiny caps)
BINE_LIVE_MODE=false
BINE_MAX_TRADE_USD=6.00
BINE_DAILY_CAP_USD=10.00

# Optional local dev DNS fallback (set true only if local router DNS fails on web3.binance.com)
DEV_DNS_FALLBACK=false

# Database (SQLite default locally; set DATABASE_URL for Postgres if needed)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/bine
